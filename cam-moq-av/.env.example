# Copy to .env and fill in your camera/relay/video details.

# Camera credentials
CAM_USER="USERNAME"
CAM_PASS="PASSWORD"
CAM_IP="IP_ADDRESS_OF_CAMERA"

RTSP_URL="rtsp://$CAM_USER:$CAM_PASS@$CAM_IP:554/cam/realmonitor?channel=1&subtype=0"

# MOQT relay
RELAY="moqt://moqrelay.example.com:443/moq-relay"
NAMESPACE="namespace/live"
TRACK="video"

# Video settings
WIDTH="1920"
HEIGHT="1080"
FPS="30"
BITRATE="4000000"
CATALOG_KEEPALIVE_MS="0"

# Low-res (subtype=1) stream settings.
# RTSP_URL_LOW is auto-derived from RTSP_URL (subtype=0 → subtype=1) if not set.
WIDTH_LOW="640"
HEIGHT_LOW="360"
BITRATE_LOW="500000"

# On-demand lifecycle: how long a source keeps pulling from the camera after
# the last subscriber leaves. Long enough to survive a page refresh or a
# quality switch, short enough not to waste camera sessions.
IDLE_MS="5000"
IDLE_MS_HI="5000"
IDLE_MS_LOW="60000"
