# Copy to .env and fill in your camera/relay/control details.

# Camera credentials
CAM_USER="USERNAME"
CAM_PASS="PASSWORD"
CAM_IP="IP_ADDRESS_OF_CAMERA"

# MOQT relay
RELAY="moqt://moqrelay.example.com:443/moq-relay"
NAMESPACE="namespace/live"
TRACK="command"

# Control settings
CAM_SPEED="5"
MAX_DURATION_MS="2000"